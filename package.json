    "core-js": "^3.15.1",
    "nuxt": "^2.15.7",
    "vue": "2.6.14",
    "vue-server-renderer": "2.6.14",
    "vue-template-compiler": "2.6.14",
    "vuetify": "^2.5.5"
  },
  "devDependencies": {
    "@nuxtjs/vuetify": "^1.12.1",
    "push-dir": "^0.4.1"
  }
}
